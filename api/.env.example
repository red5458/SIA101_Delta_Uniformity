# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local development:
DATABASE_URL=postgresql://uniformity:change-me@127.0.0.1:5432/uniformity
DATABASE_SSL=false

# Supabase (Project Settings -> Database -> Connection string): replace the
# two lines above with the SESSION pooler values below. URL-encode special
# characters in the password (@ -> %40, # -> %23, ? -> %3F).
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_SSL=auto
#
# DATABASE_SSL accepts auto (default) | true | false. `auto` turns TLS on for
# Supabase and for URLs that already contain sslmode=require.
# Set to true to verify the provider certificate chain (Supabase works).
DATABASE_SSL_STRICT=false
DATABASE_POOL_MAX=12

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Concurrent requests may race a rotation; allow the just-rotated token to be
# retried inside this window instead of being treated as replay theft.
REFRESH_REUSE_GRACE_SECONDS=30
BCRYPT_ROUNDS=12

# Cookies. All browser traffic goes through the Next.js BFF, so the cookies are
# first-party on the frontend origin and no shared parent domain is needed.
# COOKIE_SECURE defaults to true when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: return the generated code in the API response for testing.
EXPOSE_DEV_OTP=false

# ---------------------------------------------------------------------------
# Email / OTP delivery (EMAIL_MODE = console | gmail | smtp)
# ---------------------------------------------------------------------------
# console: logs the code, and EXPOSE_DEV_OTP returns it in the response (dev).
EMAIL_MODE=console
MAIL_FROM=Uniformity <no-reply@uniformity.local>

# --- Gmail API (recommended) ------------------------------------------------
# 1. Create a Google Cloud project and enable the Gmail API.
# 2. Configure the OAuth consent screen (External, Testing is fine) and add
#    the https://mail.google.com/ scope (gmail.send needs it for sending).
# 3. Create an OAuth client ID of type "Web application" and add
#    https://developers.google.com/oauthplayground as an authorized redirect
#    URI. (Use "Desktop app" only if you mint the token with a local loopback
#    script instead of the Playground.)
# 4. Authorize with the same Google account as GMAIL_USER and exchange the
#    code for a refresh token at https://developers.google.com/oauthplayground
#    (gear icon -> use your own OAuth credentials).
# 5. Set the values below and EMAIL_MODE=gmail.
# MAIL_FROM must be the authenticated mailbox or a verified "Send mail as"
# alias; otherwise Gmail rejects the message.
#
# EMAIL_MODE=gmail
# MAIL_FROM=Uniformity <your.address@gmail.com>
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- SMTP (Resend, Brevo, SES, ...) ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Cloudinary (signed direct uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Storage driver: auto | cloudinary | local
# `auto` uses Cloudinary when the three keys above are set, and otherwise falls
# back to local disk in development. Production always requires Cloudinary.
UPLOAD_DRIVER=auto
# Optional absolute path to the Next.js `public` directory (auto-detected).
# PUBLIC_DIR=C:\projects\uniformity\public

# ---------------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------------
# Generate a pair with `npm --prefix api run push:keys` (or any VAPID tool).
# Set all three: the pair here on the API, and the public key on the frontend
# as NEXT_PUBLIC_VAPID_PUBLIC_KEY (.env.local for local builds, Render/Vercel
# environment for production). Push is silently disabled when the pair is unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@bicol-u.edu.ph

# ---------------------------------------------------------------------------
# First administrator (used by `npm run bootstrap-admin`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@bicol-u.edu.ph
ADMIN_PASSWORD=change-this-before-deploying
ADMIN_NAME=Uniformity Admin
